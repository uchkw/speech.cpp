      "status": "failed",
      "evidence": "016/checks/head-store/initial-failure-classification.json",
      "reason": "The original run stopped at case 47 during graph construction. A transposed first input is invalid in ggml_mul_mat. The log retained 46 preceding comparisons and zero complete direct gates.",
      "required": false
    },
    {
      "name": "Corrected direct Metal comparisons",
      "status": "passed",
      "evidence": "016/checks/head-store-corrected/direct-result.json",
      "reason": "Each of the original, OFF and ON processes completed 52 cases and two poison guards. The three 31,451,648-byte dumps matched. ON fused 14 positive cases and kept 38 controls unfused."
    },
    {
      "name": "Logical CPU references and GGML regressions",
      "status": "passed",
      "evidence": "016/execution/gates.json",
      "reason": "Both corrected test builds passed 47 logical CPU-reference cases and 2,755 related operation cases. Five mapped-memory controls ran only in the Metal direct check."
    },
    {
      "name": "Ordinary allocator ranges",
      "status": "passed",
      "evidence": "016/allocator/result.json",
      "reason": "The original, OFF and ON helpers agreed on 1,008 ranges for 42 Q4_K, Q8_0 and F16 model/input pairs. All 864 ranges at T ≥ 64 were eligible and all 144 shorter controls were ineligible."
    },
    {
      "name": "Ordinary encoder dispatch and projection output",
      "status": "passed",
      "evidence": "016/execution/gates.json",
      "reason": "All 56 original/OFF/ON projection triples matched byte for byte across four weight types. The normal ON traces recorded 1,152 head-store fusions."
    },
    {
      "name": "Official F32 encoder reference",
      "status": "passed",
      "evidence": "016/checks/official-f32-corrected/result.json",
      "reason": "Eleven unique reference inputs ran on CPU and Metal with original, OFF and ON. All 66 checks passed. The reference covers the encoder from input features through its encoded output."
    },
    {
      "name": "Three-format request screen",
      "status": "passed",
      "evidence": "016/screen/summary.json",
      "reason": "For each format, the same nine clips produced 27 timestamp-disabled text comparisons and nine separate timestamp-enabled comparisons of text, public tokens and segments. All matched with OFF and ON."
