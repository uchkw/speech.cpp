  "title": "Reject the 64-column SIMD GEMM variant",
  "status": "rejected",
  "reason": "The 64-column variant increased paired warm request latency by 8.6% for Q8_0 and 13.7% for F16 on nine inputs over three rounds. Q4_K was an unchanged-path control. No implementation is adopted; other GEMM variants remain open.",
  "scope": "exploratory_rejected_variant",
  "conditions": {
    "name": "Haas on Apple Silicon",
    "repository": "https://github.com/uchkw/speech.cpp",
    "tracking_issue": "https://github.com/uchkw/speech.cpp/issues/1",
    "purpose": "Reduce warm latency for one Japanese voice input of a few seconds to 30 seconds while preserving recognition quality.",
    "threads": 4,
    "rounds": 3,
    "decode_on_cpu": true,
    "quality_policy": "exact",
    "latency_count": 9,
    "quality_count": 9,
    "latency_definition": "Before encoding/sending first PCM16 chunk through terminal worker end event; file reading, model load and warmup excluded.",
    "aggregation": "Linear-interpolated percentiles across nine per-input median latencies; exploratory tail estimates, not production p99 guarantees.",
    "literal_cer": "Total Unicode code-point Levenshtein edits divided by total reference code points, including punctuation, symbols and whitespace.",
    "repository_cer": "NFKC followed by removing Unicode punctuation, symbols, separators and whitespace; no case folding or alternate-spelling substitutions. Edits and reference lengths are summed before division.",
    "quality_comparison": "Nine files per type with timestamps; text and public token/segment fields are compared exactly.",
    "latency_timestamps": false,
    "quality_timestamps": true,
    "unobserved_fields": "The worker does not expose raw TDT token IDs, frame indices or duration decisions. These are not claimed to match by this harness.",
    "limitations": [
      "No measurements below 6.36 seconds.",
      "No full-corpus or official-reference accuracy conclusion.",
      "No Windows Vulkan or other-Mac validation.",
      "No independent original-shader versus experimental-32 bitwise comparison.",
      "The fixed-64 variant is experimental and is not integrated into the accepted branch.",
      "The 132 direct checks comprise 126 F16/Q8_0 target cases and six Q4_K controls using 32 columns in both settings.",
      "The source was committed after measuring; tested source hashes match the checkpoint, but the binary was not rebuilt from that clean checkpoint."
    ],
